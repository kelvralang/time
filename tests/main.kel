const time = @import("github.com/kelvralang/time")
var beforeMillis i64 = time.monotonicMillis()
var beforeNanos i64 = time.monotonicNanos()
time.sleepMillis(1)
if (time.monotonicMillis() < beforeMillis) error("monotonic millisecond clock moved backwards")
if (time.monotonicNanos() < beforeNanos) error("monotonic nanosecond clock moved backwards")
var unixMillis i64 = time.unixMillis()
var unixSeconds i64 = time.unixSeconds()
if (unixMillis <= 0 || unixSeconds <= 0) error("unix clock is positive")
if (unixMillis / 1000 < unixSeconds - 1 || unixMillis / 1000 > unixSeconds + 1) error("unix clock units disagree")
time.sleepSeconds(0)
